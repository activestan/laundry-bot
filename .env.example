# ─── Telegram Bot ────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ─── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/laundry_bot

# ─── Flutterwave ─────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_hash_here

# ─── Server ──────────────────────────────────────────────────
PORT=3000
BASE_URL=https://your-domain.com

# ─── Admin Config ────────────────────────────────────────────
# Comma-separated Telegram user IDs for admins
ADMIN_CHAT_IDS=123456789,987654321

# Comma-separated Telegram user IDs for workers
WORKER_CHAT_IDS=111111111,222222222

# ─── Business Info ───────────────────────────────────────────
BUSINESS_NAME=FreshPress Laundry
BUSINESS_WHATSAPP=+2348012345678
